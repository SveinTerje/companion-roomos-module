{
	"name": "cisco-roomos",
	"version": "3.0.0",
	"main": "dist/index.js",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SveinTerje/companion-roomos-module.git"
	},
	"license": "MIT",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"prepare": "husky install",
		"dev": "yarn build:watch",
		"build": "rimraf dist && yarn build:main",
		"build:main": "tsc",
		"build:watch": "tsc --watch",
		"lint:raw": "eslint --ext .ts --ext .js --ignore-pattern dist --ignore-pattern pkg",
		"lint": "yarn lint:raw .",
		"test:unit": "node dist/xapi-path.selftest.js",
		"postinstall": "rimraf node_modules/ssh2/lib/protocol/crypto/build node_modules/cpu-features"
	},
	"lint-staged": {
		"*.{js,json,md}": [
			"prettier --write"
		],
		"*.{ts}": [
			"yarn lint:raw --fix --"
		]
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"dependencies": {
		"@companion-module/base": "~2.1.3",
		"jsxapi": "^5.1.1"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.1.1",
		"@types/node": "^22.15.0",
		"husky": "^8.0.3",
		"lint-staged": "^13.2.2",
		"rimraf": "^5.0.1",
		"typescript": "~7.0.2"
	}
}
